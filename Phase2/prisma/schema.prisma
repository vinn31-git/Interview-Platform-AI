generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  bio               String?
  defaultRole       String?
  defaultDifficulty String?

  interviews Interview[]
}

model Interview {
  id             String   @id @default(cuid())

  role           String
  experience     String
  difficulty     String
  interviewType  String
  duration       String

  questions      String?
  answers        String?
  score          Int?
  evaluation     String?

  createdAt      DateTime @default(now())

  userId         String?
  user           User? @relation(fields: [userId], references: [id])
}